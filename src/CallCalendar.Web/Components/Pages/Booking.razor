@page "/book"
@rendermode InteractiveServer
@inject CallCalendarClient Api
@using ClientBooking = CallCalendar.Client.Models.Booking

<PageTitle>Запись на звонок</PageTitle>

<div class="page">
    <div class="container">
        <h1>Запись на звонок</h1>

        @if (apiUnavailable is not null)
        {
            <div class="stub-card">
                <p>@apiUnavailable</p>
            </div>
        }
        else if (types is null)
        {
            <div class="stub-card">
                <p>Загрузка…</p>
            </div>
        }
        else if (step == BookingStep.Done)
        {
            <div class="confirm-card">
                <h2>Запись подтверждена ✅</h2>
                <p class="confirm-main">@created!.EventTypeName · @selectedDayText, @selectedSlotText — @endTime</p>
                <p class="confirm-note">@created.Name (@created.Email)</p>
                @if (!string.IsNullOrWhiteSpace(created.AdditionalInfo))
                {
                    <p class="confirm-note">«@created.AdditionalInfo»</p>
                }
                <button class="cta secondary" @onclick="Restart">Записаться ещё раз</button>
            </div>
        }
        else if (step == BookingStep.Guest)
        {
            <div class="guest-form">
                <p class="selected-summary">@selectedType!.Name · @selectedDayText, @selectedSlotText</p>
                @if (formError is not null)
                {
                    <div class="notice"><p>@formError</p></div>
                }
                <label class="field">
                    <span>Имя *</span>
                    <input @bind="guestName" placeholder="Как к вам обращаться" />
                    @if (nameError is not null)
                    {
                        <span class="field-error">@nameError</span>
                    }
                </label>
                <label class="field">
                    <span>Email *</span>
                    <input @bind="guestEmail" placeholder="you@example.com" />
                    @if (emailError is not null)
                    {
                        <span class="field-error">@emailError</span>
                    }
                </label>
                <label class="field">
                    <span>Дополнительная информация</span>
                    <textarea @bind="guestAdditionalInfo" rows="3" placeholder="Пара слов о будущем звонке (необязательно)"></textarea>
                </label>
                <button class="cta" disabled="@submitting" @onclick="SubmitAsync">
                    @if (submitting)
                    {
                        <span>Записываю…</span>
                    }
                    else
                    {
                        <span>Записаться</span>
                    }
                </button>
            </div>
        }
        else
        {
            @if (globalNotice is not null)
            {
                <div class="notice">
                    <p>@globalNotice</p>
                </div>
            }

            <div class="booking-columns">
                <section class="column">
                    <h2>1. Тип события</h2>
                    <div class="choice-grid">
                        @foreach (var t in types)
                        {
                            <button class="choice @(t == selectedType ? "selected" : "")" @onclick="() => ChooseType(t)">
                                <span class="choice-title">@t.Name</span>
                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="choice-note">@t.Description</span>
                                }
                                <span class="choice-note">@t.DurationMinutes мин</span>
                            </button>
                        }
                    </div>
                </section>

                <section class="column">
                    <h2>2. Календарь</h2>
                    @if (selectedType is null)
                    {
                        <p class="column-hint">Сначала выберите тип события.</p>
                    }
                    else
                    {
                        <div class="calendar">
                            <div class="calendar-nav">
                                <button type="button" class="nav-arrow" aria-label="Предыдущий месяц" @onclick="PrevMonth">‹</button>
                                <span class="calendar-month">@MonthTitle</span>
                                <button type="button" class="nav-arrow" aria-label="Следующий месяц" @onclick="NextMonth">›</button>
                            </div>
                            <div class="calendar-grid">
                                @foreach (var name in weekdayNames)
                                {
                                    <span class="weekday">@name</span>
                                }
                                @foreach (var cell in CalendarCells())
                                {
                                    if (cell is null)
                                    {
                                        <span class="day empty"></span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="day @(cell.Value.Date == today ? "today" : "") @(cell.Value.Date == selectedDay.Date ? "selected" : "")"
                                                disabled="@IsPast(cell.Value)"
                                                @onclick="() => ChooseDateAsync(cell.Value)">
                                            <span>@cell.Value.Day</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </section>

                <section class="column">
                    <h2>3. Слоты</h2>
                    @if (selectedType is null)
                    {
                        <p class="column-hint">Сначала выберите тип события.</p>
                    }
                    else if (slotsLoading)
                    {
                        <div class="stub-card"><p>Ищем свободные слоты…</p></div>
                    }
                    else if (conflictNotice is not null)
                    {
                        <div class="notice">
                            <p>@conflictNotice</p>
                        </div>
                    }
                    else if (slots is { Count: 0 })
                    {
                        <div class="stub-card">
                            <p>На @selectedDayText свободных слотов нет — выберите другой день.</p>
                        </div>
                    }
                    else if (slots is not null)
                    {
                        <div class="choice-grid slots">
                            @foreach (var slot in slots)
                            {
                                <button class="choice slot" @onclick="() => ChooseSlot(slot)">
                                    <span class="choice-title">@TimePart(slot)</span>
                                </button>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </div>
</div>

@code {
    private enum BookingStep
    {
        Select,
        Guest,
        Done,
    }

    private const string UnavailableMessage = "Сервис записи временно недоступен. Попробуйте позже.";

    private static readonly string[] weekdayNames = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"];

    private static readonly string[] monthNames =
        ["январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь"];

    private BookingStep step = BookingStep.Select;
    private string? apiUnavailable;
    private List<EventType>? types;
    private EventType? selectedType;
    private DateTime selectedDay;
    private DateTime today;
    private DateTime displayedMonth;
    private List<string>? slots;
    private bool slotsLoading;
    private string? selectedSlot;
    private string? conflictNotice;
    private string? formError;
    private string? globalNotice;
    private string? nameError;
    private string? emailError;
    private bool submitting;
    private string guestName = "";
    private string guestEmail = "";
    private string? guestAdditionalInfo;
    private ClientBooking? created;
    private string? endTime;

    protected override async Task OnInitializedAsync()
    {
        today = MskClock.Now().Date;
        try
        {
            types = await Api.Api.EventTypes.GetAsync();
        }
        catch (Exception)
        {
            apiUnavailable = UnavailableMessage;
        }
    }

    private string selectedDayText => selectedDay.ToString("dd.MM.yyyy");

    private string selectedSlotText => TimePart(selectedSlot);

    /// «2026-10-21T12:00» -> «12:00» (wall-clock строка контракта, T8 Q2).
    private static string TimePart(string? wallClock) => wallClock switch
    {
        { } v when v.Contains('T') => v[(v.IndexOf('T') + 1)..],
        null => "",
        _ => wallClock,
    };

    private string MonthTitle => $"{monthNames[displayedMonth.Month - 1]} {displayedMonth.Year}";

    /// Ячейки месяца: пустые до первого дня («понедельник — первая колонка»), затем дни,
    /// в конце — пустые до целой недели.
    private List<DateTime?> CalendarCells()
    {
        var first = new DateTime(displayedMonth.Year, displayedMonth.Month, 1);
        var leadingBlanks = ((int)first.DayOfWeek + 6) % 7;
        var daysInMonth = DateTime.DaysInMonth(displayedMonth.Year, displayedMonth.Month);

        var cells = Enumerable.Repeat<DateTime?>(null, leadingBlanks).ToList();
        for (var day = 1; day <= daysInMonth; day++)
        {
            cells.Add(new DateTime(displayedMonth.Year, displayedMonth.Month, day));
        }

        while (cells.Count % 7 != 0)
        {
            cells.Add(null);
        }

        return cells;
    }

    private bool IsPast(DateTime day) => day.Date < today;

    private void PrevMonth() => displayedMonth = displayedMonth.AddMonths(-1);

    private void NextMonth() => displayedMonth = displayedMonth.AddMonths(1);

    private void ChooseType(EventType type)
    {
        selectedType = type;
        selectedDay = default;
        slots = null;
        selectedSlot = null;
        conflictNotice = null;
        globalNotice = null;
        formError = null;
        // Показываем месяц «сегодня» (MSK); навигация в будущие/прошедшие месяцы свободна.
        displayedMonth = new DateTime(today.Year, today.Month, 1);
    }

    /// Wall-clock по Москве — зеркалит серверный MskClock (T8):
    /// зона зафиксирована контрактом; Web не ссылается на Api, поэтому helper свой.
    private static class MskClock
    {
        private static readonly TimeZoneInfo Msk = TimeZoneInfo.FindSystemTimeZoneById("Europe/Moscow");

        public static DateTime Now() => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, Msk);
    }

    private async Task ChooseDateAsync(DateTime day)
    {
        selectedDay = day;
        slots = null;
        conflictNotice = null;
        slotsLoading = true;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        try
        {
            var date = new Microsoft.Kiota.Abstractions.Date(selectedDay.Year, selectedDay.Month, selectedDay.Day);
            slots = await Api.Api.EventTypes[selectedType!.Id!.Value].Availability
                .GetAsync(c => c.QueryParameters.Date = date);
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 404)
        {
            // тип события мог исчезнуть из виду — возвращаем к его выбору с пояснением
            globalNotice = "Этот тип события больше недоступен — выберите другой.";
            selectedType = null;
            slots = null;
            slotsLoading = false;
            return;
        }
        catch (Exception)
        {
            apiUnavailable = UnavailableMessage;
            slots = null;
            slotsLoading = false;
            return;
        }

        slotsLoading = false;
    }

    private void ChooseSlot(string slot)
    {
        selectedSlot = slot;
        formError = null;
        nameError = null;
        emailError = null;
        step = BookingStep.Guest;
    }

    private async Task SubmitAsync()
    {
        // защита от реэнтеранса: disabled применяется после render-раунда, второй клик может прийти в полёте
        if (submitting)
        {
            return;
        }

        nameError = string.IsNullOrWhiteSpace(guestName) ? "Имя обязательно." : null;
        emailError = !IsProbablyEmail(guestEmail) ? "Укажите корректный email." : null;
        if (nameError is not null || emailError is not null)
        {
            return;
        }

        submitting = true;
        try
        {
            created = await Api.Api.Bookings.PostAsync(new NewBooking
            {
                EventTypeId = selectedType!.Id,
                Start = selectedSlot!,
                Name = guestName.Trim(),
                Email = guestEmail.Trim(),
                AdditionalInfo = string.IsNullOrWhiteSpace(guestAdditionalInfo) ? null : guestAdditionalInfo.Trim(),
            });
            endTime = TimePart(created!.End);
            step = BookingStep.Done;
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 409)
        {
            // слот заняли во время оформления (T2) — возвращаем к сетке с обновлением
            conflictNotice = "Этот слот только что заняли. Выберите другое время.";
            step = BookingStep.Select;
            slotsLoading = true;
            await LoadSlotsAsync();
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 404)
        {
            globalNotice = "Этот тип события больше недоступен — выберите другой.";
            selectedType = null;
            slots = null;
            step = BookingStep.Select;
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 400)
        {
            formError = string.IsNullOrWhiteSpace(ex.Detail) ? "Проверьте данные записи." : ex.Detail;
        }
        catch (Exception)
        {
            formError = UnavailableMessage;
        }
        finally
        {
            submitting = false;
        }
    }

    // Клиентская эвристика; авторитет — сервер (MailAddress + problem+json 400).
    private static bool IsProbablyEmail(string value) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains('@') && !value.Contains(' ');

    private void Restart()
    {
        selectedType = null;
        displayedMonth = default;
        selectedDay = default;
        slots = null;
        selectedSlot = null;
        guestName = "";
        guestEmail = "";
        guestAdditionalInfo = null;
        created = null;
        endTime = null;
        conflictNotice = null;
        formError = null;
        globalNotice = null;
        nameError = null;
        emailError = null;
        step = BookingStep.Select;
    }
}
