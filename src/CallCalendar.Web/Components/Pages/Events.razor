@page "/admin"
@rendermode InteractiveServer
@inject CallCalendarClient Api

<PageTitle>Панель владельца</PageTitle>

<div class="page">
    <div class="container">
        <h1>Панель владельца</h1>

        @if (apiUnavailable is not null)
        {
            <div class="stub-card">
                <p>@apiUnavailable</p>
            </div>
        }
        else
        {
            <section class="admin-block">
                <h2>Типы событий</h2>
                @if (types is null)
                {
                    <p class="muted">Загрузка…</p>
                }
                else if (types.Count == 0)
                {
                    <p class="muted">Типов пока нет — создайте первый.</p>
                }
                else
                {
                    <ul class="types-list">
                        @foreach (var t in types)
                        {
                            <li>
                                <strong>@t.Name</strong> · @t.DurationMinutes мин
                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="muted"> — @t.Description</span>
                                }
                            </li>
                        }
                    </ul>
                }

                <h3>Добавить тип события</h3>
                @if (serverError is not null)
                {
                    <div class="notice"><p>@serverError</p></div>
                }
                @if (createdNote is not null)
                {
                    <div class="notice ok"><p>@createdNote</p></div>
                }
                <div class="admin-form">
                    <label class="field">
                        <span>Название *</span>
                        <input @bind="formName" placeholder="например, 30-минутный созвон" />
                        @if (nameError is not null)
                        {
                            <span class="field-error">@nameError</span>
                        }
                    </label>
                    <label class="field">
                        <span>Описание</span>
                        <input @bind="formDescription" placeholder="необязательно" />
                    </label>
                    <label class="field">
                        <span>Длительность, мин *</span>
                        <input type="number" @bind="formDuration" min="1" />
                        @if (durationError is not null)
                        {
                            <span class="field-error">@durationError</span>
                        }
                    </label>
                    <button class="cta" disabled="@saving" @onclick="SaveTypeAsync">
                        @(saving ? "Сохраняю…" : "Сохранить тип")
                    </button>
                </div>
            </section>

            <section class="admin-block">
                <h2>Предстоящие события</h2>
                @if (cancelError is not null)
                {
                    <div class="notice"><p>@cancelError</p></div>
                }
                @if (bookings is null)
                {
                    <p class="muted">Загрузка…</p>
                }
                else if (bookings.Count == 0)
                {
                    <div class="stub-card"><p>Записей пока нет.</p></div>
                }
                else
                {
                    <ul class="events-list">
                        @foreach (var b in bookings)
                        {
                            <li>
                                <span class="event-when">@b.Start — @b.End</span>
                                <span class="event-what">@b.EventTypeName</span>
                                <span class="event-who">@b.Name (@b.Email)</span>
                                @if (!string.IsNullOrWhiteSpace(b.AdditionalInfo))
                                {
                                    <span class="event-note">«@b.AdditionalInfo»</span>
                                }
                                <button class="cancel-btn" disabled="@(cancellingId is not null)" @onclick="() => CancelBookingAsync(b)">
                                    @(cancellingId == b.Id ? "Отменяю…" : "Отменить")
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="admin-block">
                <h2>Отменённые события</h2>
                @if (cancelled is null)
                {
                    <p class="muted">Загрузка…</p>
                }
                else if (cancelled.Count == 0)
                {
                    <div class="stub-card"><p>Отменённых событий нет.</p></div>
                }
                else
                {
                    <ul class="events-list cancelled-list">
                        @foreach (var b in cancelled)
                        {
                            <li>
                                <span class="event-when">@b.Start — @b.End</span>
                                <span class="event-what">@b.EventTypeName</span>
                                <span class="event-who">@b.Name (@b.Email)</span>
                                @if (!string.IsNullOrWhiteSpace(b.AdditionalInfo))
                                {
                                    <span class="event-note">«@b.AdditionalInfo»</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </div>
</div>

@code {
    private const string UnavailableMessage = "Сервис записи временно недоступен. Попробуйте позже.";

    private string? apiUnavailable;
    private List<EventType>? types;
    private List<CallCalendar.Client.Models.Booking>? bookings;
    private List<CallCalendar.Client.Models.Booking>? cancelled;
    private int? cancellingId;
    private string? cancelError;
    private string formName = "";
    private string? formDescription;
    private string? nameError;
    private string? durationError;
    private string? serverError;
    private string? createdNote;
    private bool saving;
    private int? formDuration;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception)
        {
            apiUnavailable = UnavailableMessage;
        }
    }

    private async Task ReloadAsync()
    {
        types = await Api.Api.EventTypes.GetAsync();
        bookings = await Api.Api.Bookings.GetAsync();
        cancelled = await Api.Api.Bookings.Cancelled.GetAsync();
    }

    /// Отмена записи: слот освобождается на сервере, здесь встреча локально переезжает
    /// из предстоящих в отменённые (полный перезапрос не нужен).
    private async Task CancelBookingAsync(CallCalendar.Client.Models.Booking booking)
    {
        // защита от реэнтеранса: disabled применяется после render-раунда
        if (cancellingId is not null)
        {
            return;
        }

        cancellingId = booking.Id;
        cancelError = null;
        try
        {
            var updated = await Api.Api.Bookings[booking.Id!.Value].Cancel.PostAsync();
            bookings ??= [];
            bookings.Remove(booking);
            cancelled ??= [];
            cancelled.Add(updated!);
            // Start — wall-clock строка «yyyy-MM-ddTHH:mm», порядок строк совпадает с хронологией.
            cancelled = cancelled.OrderBy(b => b.Start, StringComparer.Ordinal).ToList();
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 404 || ex.ResponseStatusCode == 409)
        {
            // Состояние на сервере изменилось (запись уже отменена в другой сессии) — перечитываем списки.
            cancelError = string.IsNullOrWhiteSpace(ex.Detail) ? "Состояние записи изменилось — списки обновлены." : ex.Detail;
            try
            {
                bookings = await Api.Api.Bookings.GetAsync();
                cancelled = await Api.Api.Bookings.Cancelled.GetAsync();
            }
            catch (Exception)
            {
                apiUnavailable = UnavailableMessage;
            }
        }
        catch (Exception)
        {
            cancelError = UnavailableMessage;
        }
        finally
        {
            cancellingId = null;
        }
    }

    private async Task SaveTypeAsync()
    {
        if (saving)
        {
            return;
        }

        nameError = string.IsNullOrWhiteSpace(formName) ? "Название обязательно." : null;
        durationError = formDuration is not > 0 ? "Длительность должна быть больше нуля." : null;
        if (nameError is not null || durationError is not null)
        {
            return;
        }

        saving = true;
        serverError = null;
        createdNote = null;
        try
        {
            var created = await Api.Api.EventTypes.PostAsync(new NewEventType
            {
                Name = formName.Trim(),
                Description = string.IsNullOrWhiteSpace(formDescription) ? null : formDescription.Trim(),
                DurationMinutes = formDuration,
            });

            // Сервер добавляет тип с максимальным id — дописываем в конец, полный перезапрос не нужен.
            types ??= [];
            types.Add(created!);
            createdNote = $"Добавлен тип «{created!.Name}».";
            formName = "";
            formDescription = null;
            formDuration = null;
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 409)
        {
            // дубль названия без учёта регистра и пробелов (T5)
            serverError = "Тип с таким названием уже есть — выберите другое (регистр и пробелы не важны).";
        }
        catch (ProblemDetails ex) when (ex.ResponseStatusCode == 400)
        {
            serverError = string.IsNullOrWhiteSpace(ex.Detail) ? "Проверьте данные типа." : ex.Detail;
        }
        catch (Exception)
        {
            serverError = UnavailableMessage;
        }
        finally
        {
            saving = false;
        }
    }
}
